<UserControl x:Class="PolarUninstallerWpf.FileBrowserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PolarUninstallerWpf">
  <UserControl.Resources>
    <ResourceDictionary Source="Styles/FileExplorer.xaml" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="NavigationBar" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" x:Name="SearchColumn" />
      </Grid.ColumnDefinitions>
      <WrapPanel x:Name="Toolbar" VerticalAlignment="Top" MaxWidth="450" />
      <Grid Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Top" Height="34">
        <Border x:Name="BreadcrumbFrame" ClipToBounds="True" SizeChanged="BreadcrumbSizeChanged" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" Padding="8,4">
          <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" MouseDown="EditAddress" MinHeight="26" />
        </Border>
        <TextBox x:Name="Address" Visibility="Collapsed" Padding="10,8" FlowDirection="LeftToRight" Background="Transparent" Foreground="{DynamicResource ChromeText}" BorderBrush="{DynamicResource ChromeAccent}" KeyDown="AddressKey" LostKeyboardFocus="AddressBlur" />
      </Grid>
      <Grid Grid.Column="2" Height="34" VerticalAlignment="Top" Margin="16,0,0,0">
        <TextBox x:Name="Search" VerticalAlignment="Top" VerticalContentAlignment="Center" Padding="30,6,30,6" Height="34" Background="Transparent" Foreground="{DynamicResource ChromeText}" BorderBrush="{DynamicResource HomeBorderBrush}" TextChanged="SearchChanged" />
        <TextBlock Text="⌕" FontSize="21" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource HomeTextBrush}" IsHitTestVisible="False" />
        <Button x:Name="ClearSearch" Content="×" HorizontalAlignment="Right" Width="28" Padding="0" Style="{StaticResource ExplorerActionButton}" Background="Transparent" BorderThickness="0" Click="ClearSearchClick" />
        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" VerticalAlignment="Center" Margin="30,0,30,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource HomeTextBrush}" Visibility="Collapsed" />
      </Grid>
    </Grid>
    <Grid x:Name="BrowserBody" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="Files" MaxWidth="1440" HorizontalAlignment="Stretch" SizeChanged="FilesSizeChanged" SelectionChanged="FilesSelectionChanged" PreviewMouseLeftButtonDown="FilesPreviewMouseLeftButtonDown" SelectionMode="Extended" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.Template>
          <ControlTemplate TargetType="ListView">
            <Border Background="Transparent">
              <ScrollViewer Background="Transparent" Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}" CanContentScroll="True" Padding="0">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </ListView.Template>
        <ListView.Resources>
          <Style TargetType="GridViewColumnHeader">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                  <Border x:Name="HeaderSurface" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SidebarHover}" />
                      <Setter Property="Foreground" Value="{DynamicResource ChromeAccent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="SortClick" />
          </Style>
        </ListView.Resources>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                  <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11">
                    <Grid>
                      <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" Margin="{TemplateBinding Padding}" />
                      <Border x:Name="SelectionHitbox" Width="42" Height="42" Margin="-5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="SelectionCircleClick" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource HomeCardBrush}" />
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView>
            <GridViewColumn Width="64">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid Width="54" Height="24">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                      <TextBlock x:Name="SelectionIndicator" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="○" />
                            <Setter Property="Foreground" Value="{DynamicResource HomeDimBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource ChromeAccent}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <Grid Grid.Column="1" Width="24" Height="24" x:Name="EntryIcon">
                      <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource ChromeAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Loaded="FileIconLoaded" DataContextChanged="FileIconChanged" Stretch="Uniform" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="NameColumn" Width="260">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="12,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="SizeColumn" Width="100">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="12,0" Text="{Binding DisplaySize}" FlowDirection="LeftToRight" TextAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="TypeColumn" Width="134">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="12,0" Text="{Binding Type}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Type}" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="DateColumn" Width="145">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Margin="12,0" Text="{Binding Modified, StringFormat=g}" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <Border x:Name="DetailsPanel" Grid.Column="1" Width="245" Margin="12,0,0,0" Padding="18" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12" Grid.RowSpan="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="DetailsHeading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" Margin="0,0,0,16" />
            <Image x:Name="DetailsIcon" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16" />
            <TextBlock x:Name="DetailsText" Foreground="{DynamicResource HomeTextBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="DetailsPath" IsReadOnly="True" FlowDirection="LeftToRight" Foreground="{DynamicResource HomeTextBrush}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" Margin="0,12,0,4" />
            <Button x:Name="DetailsCopy" Style="{StaticResource ExplorerActionButton}" Click="DetailsCopyPath" Margin="0,0,0,10" />
            <Button x:Name="DetailsLocation" Style="{StaticResource ExplorerPrimaryButton}" Click="DetailsOpenLocation" />
            <Button x:Name="DetailsSize" Margin="0,6,0,0" Style="{DynamicResource ChromeButton}" Click="DetailsCalculateSize" />
            <ProgressBar x:Name="DetailsProgress" Height="4" IsIndeterminate="False" Visibility="Collapsed" Foreground="{DynamicResource ChromeAccent}" Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid x:Name="Actions" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
      </Grid>
    </Grid>
    <ContentControl x:Name="DuplicateHost" Grid.Row="1" Grid.RowSpan="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
    <StackPanel Grid.Row="3">
      <ContentControl x:Name="SelectionTipHost" />
      <DockPanel x:Name="StatusFooter" SizeChanged="StatusFooterSizeChanged">
        <local:ShortcutHintLine x:Name="BrowserShortcutHint" DockPanel.Dock="Right" VerticalAlignment="Center" />
        <TextBlock x:Name="Status" Margin="2,8" FontSize="13" Foreground="{DynamicResource HomeTextBrush}" TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>

<Window x:Class="PolarUninstallerWpf.UpdateCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Polar Uninstaller Update" Width="900" Height="720" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True" Background="{DynamicResource ChromeBackground}" Foreground="{DynamicResource ChromeText}" FontFamily="{DynamicResource InterfaceFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="PrimaryUpdateButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChromeAccentText}" />
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryUpdateButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Branding and update headline -->
        <Border Grid.Row="0" Padding="28,22,28,20" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="56" Height="56" VerticalAlignment="Center" FlowDirection="LeftToRight" Source="{DynamicResource PolarLogoImage}" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrandText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ChromeText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{DynamicResource HomeDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1">
                    <TextBlock x:Name="StatusPillText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Installed versus available version -->
        <Border Grid.Row="1" Margin="28,18,28,0" CornerRadius="14" Padding="22,14" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="CurrentLabel" FontSize="11" Foreground="{DynamicResource HomeDimBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentVersionText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ChromeAccent}" VerticalAlignment="Center" Margin="24,0" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="LatestLabel" FontSize="11" Foreground="{DynamicResource HomeDimBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="LatestVersionText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ChromeAccent}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- What's New: this is the only independently scrolling region -->
        <Border Grid.Row="2" Margin="28,14,28,0" CornerRadius="14" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewHeading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReleaseMeta" FontSize="11" Foreground="{DynamicResource HomeDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="NotesLanguageHint" Grid.Column="1" FontSize="11" Foreground="{DynamicResource HomeDimBrush}" Margin="12,2,0,0" MaxWidth="280" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
                <Border Grid.Row="1" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
                    <FlowDocumentScrollViewer x:Name="NotesViewer" Margin="10,6,10,8" Background="Transparent" BorderThickness="0" Focusable="True" IsToolBarVisible="False" IsSelectionEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="120" />
                </Border>
            </Grid>
        </Border>

        <!-- Download and installation status (hidden until an action starts) -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="28,12,28,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadBar" Height="6" Maximum="100" Minimum="0" Foreground="{DynamicResource ChromeAccent}" Background="{DynamicResource ChromeBorder}" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource ChromeText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="TransferText" Foreground="{DynamicResource HomeDimBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
            <TextBlock x:Name="InstallNotice" Foreground="{DynamicResource HomeDimBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Exactly two decision buttons, always outside the scrolling notes -->
        <Border Grid.Row="4" Margin="0,18,0,0" Padding="28,16,28,18" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateLaterButton" Style="{StaticResource SecondaryUpdateButton}" Click="UpdateLaterClick" />
                <Button x:Name="UpdateNowButton" Style="{StaticResource PrimaryUpdateButton}" Margin="10,0,0,0" Click="UpdateNowClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

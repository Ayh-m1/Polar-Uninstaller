<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PolarUninstaller">
      <HintPath Condition="'$(PolarAssemblyPath)'==''">..\..\bin\Release\net9.0-windows\win-x64\PolarUninstaller.dll</HintPath>
      <HintPath Condition="'$(PolarAssemblyPath)'!=''">$(PolarAssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>

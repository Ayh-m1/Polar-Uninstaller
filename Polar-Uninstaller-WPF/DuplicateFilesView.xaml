<UserControl x:Class="PolarUninstallerWpf.DuplicateFilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PolarUninstallerWpf" FontFamily="{DynamicResource InterfaceFont}" Foreground="{DynamicResource HomeTextBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/FileExplorer.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="DuplicateCheck" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Border Background="Transparent" Padding="5">
                <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeAccent}" BorderThickness="1.2">
                  <TextBlock x:Name="Mark" Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Visibility="Collapsed" Foreground="{DynamicResource ChromeAccentText}" />
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{DynamicResource ChromeAccent}" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                  <Setter TargetName="Mark" Property="Text" Value="−" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource ChromeAccent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DuplicateCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HomeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
      </Style>
      <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Margin" Value="0,0,5,4" />
        <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Surface" Background="{DynamicResource HomeCardBrush}" BorderBrush="{DynamicResource HomeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Expander">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <StackPanel>
                <ToggleButton PreviewKeyDown="GroupToggleKeyDown" Foreground="{DynamicResource HomeTextBrush}" FocusVisualStyle="{StaticResource ExplorerFocus}" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" AutomationProperties.Name="{Binding ExpandName}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="2,8">
                        <DockPanel>
                          <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="⌄" Foreground="{DynamicResource ChromeAccent}" Margin="12,0" />
                          <ContentPresenter />
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="Text" Value="⌃" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter Content="{TemplateBinding Header}" />
                </ToggleButton>
                <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GroupItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Card" Background="{DynamicResource HomeCardBrush}" BorderBrush="{DynamicResource HomeBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ChromeAccent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CopyItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,4,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button x:Name="DuplicateHelpButton" Content="?" DockPanel.Dock="Right" Style="{StaticResource ExplorerActionButton}" Width="34" Padding="0" Margin="8,0,0,0" Click="DuplicateHelpClick" />
      <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource ExplorerActionButton}" Click="BackClick" Margin="12,0,0,0" />
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
        <local:SelectableText x:Name="Subtitle" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource DuplicateCard}" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button x:Name="BrowseButton" Style="{StaticResource ExplorerActionButton}" Click="Browse" Margin="8,0,0,0" />
            <Button x:Name="ScanButton" Style="{StaticResource ExplorerPrimaryButton}" Click="Scan" Margin="8,0,0,0" />
            <Button x:Name="CancelButton" Style="{StaticResource ExplorerActionButton}" Click="Cancel" Margin="8,0,0,0" Visibility="Collapsed" />
          </StackPanel>
          <TextBox x:Name="PathInput" FlowDirection="LeftToRight" VerticalContentAlignment="Center" Padding="9,7" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderBrush="{DynamicResource HomeBorderBrush}" TextChanged="ScanPathChanged" FocusVisualStyle="{StaticResource ExplorerFocus}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <local:SelectableText x:Name="Status" />
          <ProgressBar x:Name="Progress" Margin="0,7,0,0" Height="4" Maximum="100" Foreground="{DynamicResource ChromeAccent}" Background="{DynamicResource HomeBorderBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
      <Border Style="{StaticResource DuplicateCard}" Padding="10,7" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock x:Name="GroupsLabel" />
          <local:SelectableText x:Name="GroupsValue" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DuplicateCard}" Padding="10,7" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock x:Name="CopiesLabel" />
          <local:SelectableText x:Name="CopiesValue" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DuplicateCard}" Padding="10,7" Margin="0,0,6,0" BorderBrush="{DynamicResource ChromeAccent}">
        <StackPanel>
          <TextBlock x:Name="SpaceLabel" />
          <local:SelectableText x:Name="SpaceValue" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" FlowDirection="LeftToRight" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DuplicateCard}" Padding="10,7">
        <StackPanel>
          <TextBlock x:Name="ScannedLabel" />
          <local:SelectableText x:Name="ScannedValue" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </UniformGrid>
    <StackPanel Grid.Row="3" Margin="0,0,0,8">
      <WrapPanel x:Name="Filters" />
      <WrapPanel>
        <TextBlock x:Name="MinimumLabel" VerticalAlignment="Center" Margin="0,0,7,4" />
        <TextBox x:Name="MinimumSize" Text="0" Width="65" FlowDirection="LeftToRight" Padding="7,5" Margin="0,0,8,4" TextChanged="FiltersChanged" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderBrush="{DynamicResource HomeBorderBrush}" FocusVisualStyle="{StaticResource ExplorerFocus}" />
        <local:SortMenuButton x:Name="ResultsSort" Margin="0,0,8,4" />
        <Button x:Name="SmartSelectButton" Style="{StaticResource ExplorerActionButton}" Click="SmartSelectMenu" Margin="0,0,8,4" />
        <Grid Width="240" Margin="0,0,0,4">
          <TextBox x:Name="ResultsSearch" Padding="8,5" TextChanged="FiltersChanged" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderBrush="{DynamicResource HomeBorderBrush}" FocusVisualStyle="{StaticResource ExplorerFocus}" />
          <TextBlock Text="{Binding Tag,ElementName=ResultsSearch}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text,ElementName=ResultsSearch}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="5">
      <ListBox x:Name="Results" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" PreviewKeyDown="ResultsKeyDown" FocusVisualStyle="{StaticResource ExplorerFocus}" ItemContainerStyle="{StaticResource GroupItem}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Expander IsExpanded="{Binding Expanded,Mode=TwoWay}">
              <Expander.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsThreeState="True" IsChecked="{Binding Selected,Mode=TwoWay}" Style="{StaticResource DuplicateCheck}" AutomationProperties.Name="{Binding SelectionName}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="23" Foreground="{DynamicResource ChromeAccent}" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource HomeTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding CopyLabel}" Foreground="{DynamicResource HomeTextBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding RecoveryHeading}" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" />
                      <TextBlock Text="{Binding RecoveryValue}" FlowDirection="LeftToRight" FontWeight="SemiBold" Foreground="{DynamicResource ChromeAccent}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock Text="{Binding FileSizeValue}" FlowDirection="LeftToRight" Foreground="{DynamicResource HomeTextBrush}" />
                      <TextBlock Text="{Binding EachLabel}" Margin="5,0" Foreground="{DynamicResource HomeTextBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Expander.Header>
              <ListBox ItemsSource="{Binding Copies}" MaxHeight="330" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" FocusVisualStyle="{StaticResource ExplorerFocus}" ItemContainerStyle="{StaticResource CopyItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding SelectionHint}" Style="{StaticResource DuplicateCheck}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Path}" />
                      <StackPanel Grid.Column="1">
                        <WrapPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0" />
                          <Border CornerRadius="5" Padding="5,1">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource HomeCardBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsRetained}" Value="True">
                                    <Setter Property="Background" Value="#153C2B" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CopyRole}" Foreground="{Binding BadgeBrush}" FontSize="12" ToolTip="{Binding SelectionHint}" />
                          </Border>
                        </WrapPanel>
                        <local:MiddlePathText FullPath="{Binding ParentPath}" FontSize="12" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Modified}" FlowDirection="LeftToRight" FontSize="12" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding KeepLabel}" IsEnabled="{Binding CanSelect}" Style="{StaticResource ExplorerActionButton}" Click="KeepCopyClick" Margin="0,0,7,0" />
                        <Button Content="↗" Width="34" Padding="0" ToolTip="{Binding LocationLabel}" AutomationProperties.Name="{Binding LocationLabel}" Style="{StaticResource ExplorerActionButton}" Click="CopyLocationClick" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="20">
        <TextBlock Text="◇" Foreground="{DynamicResource ChromeAccent}" FontSize="38" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyHint" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="6" Margin="0,8,0,0">
      <Grid x:Name="DuplicateStatusFooter" SizeChanged="DuplicateFooterSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <local:SelectableText x:Name="SelectionSummary" FontSize="13" Margin="0,0,0,8" />
        <local:ShortcutHintLine x:Name="DuplicateShortcutHint" Grid.Column="1" Margin="16,0,0,8" />
      </Grid>
      <TextBlock x:Name="CleanupToast" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource ChromeAccent}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="RecycleButton" Style="{StaticResource ExplorerPrimaryButton}" Click="Recycle" Margin="0,0,8,0" />
        <Button x:Name="ClearSelectionButton" Grid.Column="1" Style="{StaticResource ExplorerActionButton}" Click="ClearSelection" />
        <Button x:Name="PermanentButton" Grid.Column="3" Style="{StaticResource ExplorerDangerButton}" Click="Permanent" Margin="20,0,0,0" />
      </Grid>
      <TextBox x:Name="CleanupDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource HomeTextBrush}" BorderThickness="0" />
    </StackPanel>
    <ContentControl x:Name="DuplicateTipHost" Grid.Row="4" />
  </Grid>
</UserControl>
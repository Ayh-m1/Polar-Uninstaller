 <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ExplorerFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource ChromeAccent}" BorderThickness="2" CornerRadius="8" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ExplorerActionButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}" xmlns:fx="clr-namespace:PolarUninstallerWpf"><Setter Property="FocusVisualStyle" Value="{StaticResource ExplorerFocus}"/><Setter Property="fx:CalmHover.Radius" Value="8"/></Style>
  <Style xmlns:fx="clr-namespace:PolarUninstallerWpf" x:Key="ExplorerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ExplorerActionButton}"><Setter Property="fx:CalmHover.Kind" Value="Primary"/><Setter Property="Background" Value="{DynamicResource ChromeAccent}"/><Setter Property="Foreground" Value="{DynamicResource ChromeAccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Style>
  <SolidColorBrush x:Key="ExplorerDangerBrush" Color="#B3261E"/>
  <Style xmlns:fx="clr-namespace:PolarUninstallerWpf" x:Key="ExplorerDangerButton" TargetType="Button" BasedOn="{StaticResource ExplorerActionButton}"><Setter Property="fx:CalmHover.Kind" Value="Danger"/><Setter Property="Background" Value="{StaticResource ExplorerDangerBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource ExplorerDangerBrush}"/></Style>
  <Style TargetType="Thumb" x:Key="ExplorerThumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource HomeBorderBrush}" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ExplorerThumb}" MinHeight="22"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ExplorerMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><DockPanel><ContentPresenter ContentSource="Icon" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock Text="{TemplateBinding InputGestureText}" DockPanel.Dock="Right" Margin="24,0,0,0" FlowDirection="LeftToRight"/><ContentPresenter ContentSource="Header"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="BrowserDirectionalCell" TargetType="TextBlock">
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="RightToLeft">
        <Setter Property="TextAlignment" Value="Right"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>

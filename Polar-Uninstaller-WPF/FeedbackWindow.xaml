<Window x:Class="PolarUninstallerWpf.FeedbackWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="650" Height="660" MinWidth="490" MinHeight="560" WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource InterfaceFont}" Background="{DynamicResource ChromeBackground}" Foreground="{DynamicResource ChromeText}">
 <Window.Resources>
  <Style x:Key="CategoryButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarHover}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/><Setter Property="Foreground" Value="{DynamicResource ChromeAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource SidebarSelected}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,4"><TextBlock x:Name="VersionLabel" FontSize="11"/></Border><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
  <TextBlock x:Name="Subtitle" Grid.Row="1" Margin="0,9,0,20" TextWrapping="Wrap" Foreground="{DynamicResource HomeDimBrush}"/>
  <TextBlock x:Name="CategoryLabel" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <UniformGrid Grid.Row="3" Columns="3" Margin="-2,0,-2,16"><RadioButton x:Name="Bug" GroupName="FeedbackCategory" Style="{StaticResource CategoryButton}"/><RadioButton x:Name="Suggestion" GroupName="FeedbackCategory" Style="{StaticResource CategoryButton}"/><RadioButton x:Name="Other" GroupName="FeedbackCategory" Style="{StaticResource CategoryButton}"/></UniformGrid>
  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="MessageLabel" FontWeight="SemiBold" Margin="0,0,0,8"/><Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ChromeBorder}" Background="{DynamicResource DialogSurfaceBrush}"><Grid><TextBox x:Name="MessageInput" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ChromeText}" CaretBrush="{DynamicResource ChromeAccent}" TextChanged="MessageChanged"/><TextBlock x:Name="Placeholder" Margin="14,12" Foreground="{DynamicResource HomeDimBrush}" IsHitTestVisible="False" TextWrapping="Wrap"/></Grid></Border></Grid>
  <TextBlock x:Name="Counter" Grid.Row="5" HorizontalAlignment="Right" Foreground="{DynamicResource HomeDimBrush}" Margin="0,5,0,8"/>
  <StackPanel Grid.Row="6"><TextBlock x:Name="Privacy" TextWrapping="Wrap" Foreground="{DynamicResource HomeDimBrush}" FontSize="11"/><TextBlock x:Name="Status" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ChromeAccent}"/></StackPanel>
  <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="CancelButton" Style="{StaticResource ChromeButton}" Margin="0,0,8,0" Click="CancelClick" IsCancel="True"/><Button x:Name="SendButton" Style="{StaticResource ChromeButton}" Click="SendClick" IsDefault="True"/></StackPanel>
 </Grid>
</Window>

<UserControl xmlns:local="clr-namespace:PolarUninstallerWpf" x:Class="PolarUninstallerWpf.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="HomeCard" TargetType="Button" BasedOn="{StaticResource ChromeButton}" xmlns:fx="clr-namespace:PolarUninstallerWpf">
   <Setter Property="Background" Value="{DynamicResource HomeCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HomeBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="18"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>

  <Setter Property="fx:CalmHover.Radius" Value="16"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
  <Style x:Key="CardDescription" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource HomeDimBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
  <Style x:Key="IconBox" TargetType="Border"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="13"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource HomeBorderBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MaxWidth="1000" MinWidth="520" Margin="12,12,12,20" VerticalAlignment="Center">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="6,0,6,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><local:SelectableText x:Name="VersionText" Foreground="{DynamicResource HomeAccentBrush}" FontSize="12" FontWeight="SemiBold"/><local:SelectableText x:Name="Heading" Foreground="{DynamicResource HomeTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/><local:SelectableText x:Name="Subtitle" Foreground="{DynamicResource HomeDimBrush}" FontSize="12"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,4">
     <TextBlock x:Name="Count" Foreground="{DynamicResource HomeTextBrush}" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold"/>
     <TextBlock x:Name="CountCaption" Foreground="{DynamicResource HomeDimBrush}" HorizontalAlignment="Center" FontSize="10"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HomeCard}" Tag="uninstall" Click="Navigate" MinHeight="155"><StackPanel><Border Style="{StaticResource IconBox}"><TextBlock Text="⊗" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="{DynamicResource HomeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="UninstallTitle" Style="{StaticResource CardTitle}"/><TextBlock x:Name="UninstallDesc" Style="{StaticResource CardDescription}"/></StackPanel></Button>
    <Button Grid.Column="2" Style="{StaticResource HomeCard}" Tag="cleaner" Click="Navigate" MinHeight="155"><StackPanel><Border Style="{StaticResource IconBox}"><TextBlock Text="✧" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="{DynamicResource HomeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="CleanerTitle" Style="{StaticResource CardTitle}"/><TextBlock x:Name="CleanerDesc" Style="{StaticResource CardDescription}"/></StackPanel></Button>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Style="{StaticResource HomeCard}" Tag="dashboard" Click="Navigate" MinHeight="140"><StackPanel><Border Style="{StaticResource IconBox}"><TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="21" Foreground="{DynamicResource HomeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="DashboardTitle" Style="{StaticResource CardTitle}"/><TextBlock x:Name="DashboardDesc" Style="{StaticResource CardDescription}"/></StackPanel></Button>
    <Button Grid.Column="1" Style="{StaticResource HomeCard}" Tag="files" Click="Navigate" MinHeight="140"><StackPanel><Border Style="{StaticResource IconBox}"><TextBlock Text="▱" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="{DynamicResource HomeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="FilesTitle" Style="{StaticResource CardTitle}"/><TextBlock x:Name="FilesDesc" Style="{StaticResource CardDescription}"/></StackPanel></Button>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>

<UserControl x:Class="PolarUninstallerWpf.ThemeGalleryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PolarUninstallerWpf" FontFamily="{DynamicResource InterfaceFont}" Foreground="{DynamicResource DialogTextBrush}"
 Focusable="True" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="GalleryKeyDown">
 <UserControl.Resources>
  <Style x:Key="GalleryAction" TargetType="Button" BasedOn="{StaticResource ChromeButton}" xmlns:fx="clr-namespace:PolarUninstallerWpf"><Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}"/><Setter Property="Background" Value="{DynamicResource DialogCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="fx:CalmHover.Radius" Value="11"/></Style>
  <Style x:Key="GalleryCard" TargetType="Button" BasedOn="{StaticResource ChromeButton}" xmlns:fx="clr-namespace:PolarUninstallerWpf"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource DialogCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="fx:CalmHover.Radius" Value="18"/></Style>
  <Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource DialogDimBrush}" CornerRadius="4" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="30"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid x:Name="Backdrop" Background="{DynamicResource DialogBackdropBrush}" MouseDown="BackdropClick">
  <Border x:Name="PanelFrame" Background="{DynamicResource DialogSurfaceBrush}" CornerRadius="24" BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1" Padding="22" Margin="40,32" MaxWidth="1180" MaxHeight="780" VerticalAlignment="Center" HorizontalAlignment="Stretch">
   
   <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.2"/></Border.Effect>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><Path Data="M 16,2 C 8,2 2,8 2,15 C 2,22 8,27 14,27 C 17,27 18,24 17,22 C 15,19 18,17 21,18 C 27,19 30,15 28,10 C 26,5 22,2 16,2 Z M 8,12 A 1,1 0 1 1 10,12 A 1,1 0 1 1 8,12 M 13,7 A 1,1 0 1 1 15,7 A 1,1 0 1 1 13,7 M 20,8 A 1,1 0 1 1 22,8 A 1,1 0 1 1 20,8" Stroke="{DynamicResource DialogTextBrush}" StrokeThickness="1.6" Width="30" Height="30" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Subtitle" Foreground="{DynamicResource DialogDimBrush}" Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="16,0,0,0"><Button x:Name="CloseButton" Content="×" Width="40" Height="36" Padding="0" FontSize="24" Style="{StaticResource GalleryAction}" Click="CancelClick" HorizontalAlignment="Right"/><Border Background="{DynamicResource DialogCardBrush}" CornerRadius="12" Padding="10,5" Margin="0,12,0,0"><TextBlock x:Name="CountText" Foreground="{DynamicResource DialogDimBrush}" FontSize="12"/></Border></StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DialogBorderBrush}" Padding="0,15,0,8">
     <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly"><local:ThemeGalleryPanel x:Name="Cards"/></ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="0,14,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionText" Foreground="{DynamicResource DialogDimBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Style="{StaticResource GalleryAction}" Margin="0,0,10,0" Click="CancelClick" MinWidth="100"/><Button x:Name="ApplyButton" Style="{StaticResource GalleryAction}" FontWeight="SemiBold" MinWidth="160" Click="ApplyClick"/></StackPanel></Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>

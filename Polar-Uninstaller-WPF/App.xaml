<Application x:Class="PolarUninstallerWpf.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="Window"><Setter Property="Icon" Value="/PolarUninstaller;component/Assets/Polar.ico"/></Style>
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Margin="2" CornerRadius="3" Background="{DynamicResource ChromeBorder}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ChromeAccent}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
    </Track></Grid>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource ChromeBackground}"/>
   <Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="6">
     <ScrollViewer Background="Transparent" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator">
   <Setter Property="Background" Value="{DynamicResource HomeBorderBrush}"/>
   <Setter Property="Margin" Value="6,4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}" Height="1"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <FontFamily x:Key="InterFont">./Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="TajawalFont">./Assets/Fonts/#Tajawal</FontFamily>
  <FontFamily x:Key="InterfaceFont">./Assets/Fonts/#Inter</FontFamily>
  <SolidColorBrush x:Key="ChromeAccentText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentButtonBackground" Color="#161616"/>
  <SolidColorBrush x:Key="NotesFeatureBrush" Color="#7FD6A3"/>
  <SolidColorBrush x:Key="NotesFixBrush" Color="#F08B88"/>
  <Style x:Key="CalmButtonBase" TargetType="{x:Type ButtonBase}" xmlns:fx="clr-namespace:PolarUninstallerWpf">
 <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromeBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="fx:CalmHover.Enabled" Value="True"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ButtonBase}">
 <Grid x:Name="CalmRoot" ClipToBounds="True" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Grid.RenderTransform>
 <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding fx:CalmHover.Radius}"/>
 <Border x:Name="CalmOverlay" Opacity="0" IsHitTestVisible="False" BorderThickness="1" CornerRadius="{TemplateBinding fx:CalmHover.Radius}"/>
 <Border x:Name="CalmLight" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource CalmGlowBrush}" CornerRadius="{TemplateBinding fx:CalmHover.Radius}" Margin="1"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
 <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
 <Border x:Name="CalmFocus" Opacity="0" BorderBrush="{DynamicResource CalmFocusBrush}" BorderThickness="2" CornerRadius="{TemplateBinding fx:CalmHover.Radius}" IsHitTestVisible="False"/>
 </Grid>
 <ControlTemplate.Triggers>
 <MultiTrigger><MultiTrigger.Conditions><Condition Property="fx:CalmHover.Nav" Value="True"/><Condition Property="Tag" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SidebarSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></MultiTrigger>
 <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CalmFocus" Property="Opacity" Value="1"/></Trigger>
 <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CalmRoot" Property="Opacity" Value="0.55"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
  <Style TargetType="Button" BasedOn="{StaticResource CalmButtonBase}"/>
  <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromeBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="MaxWidth" Value="380"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/></Style>
  <Style TargetType="local:SelectableText" xmlns:local="clr-namespace:PolarUninstallerWpf">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SelectableText">
    <Border Background="{TemplateBinding Background}">
     <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/></Style>
  <Style x:Key="CleanerCheckBox" TargetType="CheckBox">
   <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource HomeTextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderBrush="{DynamicResource ChromeAccent}" BorderThickness="1.2" Background="{DynamicResource ChromeBackground}" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ChromeText}" Visibility="Collapsed"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ChromeAccent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource ChromeBackground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="NumberSubstitution.CultureSource" Value="Override"/><Setter Property="NumberSubstitution.CultureOverride" Value="en-US"/><Setter Property="NumberSubstitution.Substitution" Value="European"/></Style>
  <Style x:Key="LogEntryContainer" TargetType="ListBoxItem">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="LogEntrySurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LogEntrySurface" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource CalmButtonBase}" xmlns:fx="clr-namespace:PolarUninstallerWpf"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="fx:CalmHover.Nav" Value="True"/><Setter Property="fx:CalmHover.Radius" Value="10"/></Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource CalmButtonBase}"/>
  <Style x:Key="CalmToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource CalmButtonBase}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="0"/></Style>
  <Style x:Key="ThemeItem" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="Background" Value="{DynamicResource ChromeBackground}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ChromeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ThemeCombo" TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="ItemContainerStyle" Value="{StaticResource ThemeItem}"/><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Style="{StaticResource CalmToggleButton}" x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False"></ToggleButton><ContentPresenter Margin="12,0,26,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/><TextBlock Text="⌄" Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>


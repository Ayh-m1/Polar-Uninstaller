<UserControl x:Class="PolarUninstallerWpf.DeepUninstallerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>  <Style x:Key="UninstallAction" TargetType="Button" BasedOn="{StaticResource ChromeButton}"><Setter Property="MinHeight" Value="42"/><Setter Property="MinWidth" Value="156"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers></Style>
  <Style x:Key="CardCheck" TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Box" Width="22" Height="22" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ChromeBorder}" Background="{DynamicResource ChromeBackground}"><TextBlock x:Name="Tick" Text="✓" Foreground="{DynamicResource ChromeBackground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ChromeAccent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SearchField" TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="{DynamicResource ChromeBackground}"/><Setter Property="Foreground" Value="{DynamicResource ChromeText}"/><Setter Property="CaretBrush" Value="{DynamicResource ChromeAccent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ChromeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" Foreground="{DynamicResource HomeTextBrush}" FontSize="25" FontWeight="SemiBold" Margin="5,0,5,12"/>
  <DockPanel Grid.Row="1" Margin="5,0,5,8"><ComboBox x:Name="SortSelector" DockPanel.Dock="Right" Width="210" Height="38" VerticalAlignment="Center" Style="{StaticResource ThemeCombo}" SelectionChanged="SortChanged" Margin="8,0,0,0"/><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Click="RefreshClick" Margin="8,0,0,0" Height="38" MinWidth="92" Background="Transparent" BorderBrush="Transparent"/><TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource HomeDimBrush}" VerticalAlignment="Center" Margin="8,0"/><Grid><TextBox x:Name="Search" Style="{StaticResource SearchField}" Padding="32,7,10,7" TextChanged="SearchChanged"/><TextBlock Text="⌕" FontSize="19" Margin="10,0" Foreground="{DynamicResource HomeDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/></Grid></DockPanel>
  <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="SelectionChanged">
   <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Background="Transparent" Focusable="False" Padding="0" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Border Loaded="CardLoaded" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12" Margin="5,4" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="Transparent"><Grid><TextBlock Text="{Binding FallbackGlyph}" Foreground="{DynamicResource HomeDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid></Border><TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource HomeTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding Version}" Foreground="{DynamicResource HomeTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" Foreground="{DynamicResource HomeDimBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding Publisher}" Foreground="{DynamicResource HomeDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="RightToLeft"><Setter Property="TextAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="{DynamicResource HomeDimBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center"/><CheckBox Grid.Column="5" Style="{StaticResource CardCheck}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <DockPanel Grid.Row="3" Margin="5,10,5,0"><TextBlock x:Name="SelectedDetails" DockPanel.Dock="Left" Foreground="{DynamicResource HomeDimBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="SteamDb" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Click="SteamDbClick" Visibility="Collapsed" Margin="0,0,8,0" Height="38" MinWidth="118" Background="Transparent" BorderBrush="Transparent"/><Button x:Name="Games" DockPanel.Dock="Right" Style="{StaticResource UninstallAction}" Click="GamesClick" IsEnabled="False"/><Button x:Name="Deep" DockPanel.Dock="Right" Style="{StaticResource UninstallAction}" Margin="0,0,8,0" IsEnabled="False"/><TextBlock x:Name="Status" Foreground="{DynamicResource HomeDimBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>





